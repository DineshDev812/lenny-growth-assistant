# Application
APP_NAME=Lenny Growth Assistant
# required — used in OpenAPI title and logs
LOG_LEVEL=INFO
# optional — logging verbosity (DEBUG, INFO, WARNING, ERROR)

# Database (Compose postgres service)
POSTGRES_USER=lenny
# required — Postgres username
POSTGRES_PASSWORD=lenny
# required — Postgres password (change for anything beyond local)
POSTGRES_DB=lenny
# required — Postgres database name
DATABASE_URL=postgresql+asyncpg://lenny:lenny@postgres:5432/lenny
# required — async SQLAlchemy URL; host `postgres` is the Compose service name

# Signed anonymous cookie
SECRET_KEY=change-me-in-local-dev-not-for-production
# required — signs the client_id cookie; change before any shared deploy
COOKIE_NAME=client_id
# optional — cookie that stores the signed anonymous client_id
COOKIE_SECURE=false
# optional — set true when serving over HTTPS
COOKIE_SAMESITE=lax
# optional — SameSite attribute (lax, strict, or none)

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# optional — comma-separated browser origins allowed to send credentials

# Model provider (config-only; Phase 2 does not call a model yet)
MODEL_PROVIDER=ollama
# optional — ollama or anthropic; default ollama so the stack works without a cloud key
ANTHROPIC_API_KEY=
# optional — required only when MODEL_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
# optional — Claude model id when using Anthropic
OLLAMA_BASE_URL=http://host.docker.internal:11434
# optional — API container reaches host Ollama here; do not run Ollama in Compose
OLLAMA_MODEL=qwen2.5:3b
# optional — local model name

# Ingest (used in a later phase)
INGEST_TOKEN=
# optional — protects POST /api/ingest when that endpoint exists
